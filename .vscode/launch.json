{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (CMake)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/debug/huffman_tests",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: compilar debug",
      "setupCommands": [
        {
          "description": "Habilitar pretty-printing do gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
