{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configurar debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "debug",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: compilar debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "debug", "--parallel"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "dependsOn": "CMake: configurar debug",
      "presentation": {
        "focus": true
      }
    }
  ]
}
